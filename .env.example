# Kopiraj v .env in izpolni (Supabase › Project Settings › API).
# URL in javni ključ gresta v aplikacijo – javni ključ sme biti viden.
# Novi ključi: Publishable key (sb_publishable_…) in Secret keys › default (sb_secret_…).
# Delujejo tudi stari (Legacy API keys): anon in service_role.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Skrivni ključ – SAMO za npm run baza (nalaganje vprašanj). Nikoli ga ne daj v aplikacijo ali na git.
SUPABASE_SERVICE_ROLE_KEY=
